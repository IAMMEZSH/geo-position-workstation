{
  "name": "geo-position-workstation",
  "version": "1.0.0",
  "description": "经纬度定位工作站 · 离线优先的多源定位与测量工作站（双击 index.html 即用；七个内核 623 道自检闸门，浏览器侧与 Node 侧同数，含 71 道异步门；桥接有 Python 与 PowerShell 两份实现，不装 Python 也能全功能）",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:all": "node tests/run-all.mjs --with-server --with-bridge",
    "test:package": "python tests/check-package.py",
    "test:parity": "python tests/bridge-parity.py",
    "bridge": "python server.py",
    "bridge:selftest": "python server.py --selftest",
    "bridge:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File bridge-powershell.ps1",
    "bridge:ps:selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File bridge-powershell.ps1 -SelfTest",
    "data": "node 工具/build-data.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "geodesy", "gnss", "coordinates", "utm", "mgrs", "geohash", "plus-code",
    "gcj-02", "bd-09", "traceroute", "geoip", "offline-first", "nmea"
  ],
  "files": [
    "index.html",
    "README.md",
    "LICENSE",
    "MANUAL.md",
    "app",
    "vendor",
    "docs/img",
    "images",
    "示例数据",
    "工具",
    "tests",
    "server.py",
    "bridge-powershell.ps1",
    "启动-Windows.bat",
    "启动-macOS.command",
    "启动-macOS-Linux.sh",
    "启动-Android.sh",
    "启动-iSH.sh"
  ]
}
