{
  "name": "geo-position-workstation",
  "version": "1.0.0",
  "description": "经纬度定位工作站 · 离线优先的多源定位与测量工作站（双击 index.html 即用，六个内核 515 道自检闸门，Node 侧含异步门 540 道）",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:all": "node tests/run-all.mjs --with-server",
    "bridge": "python server.py",
    "bridge:selftest": "python server.py --selftest"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "geodesy", "gnss", "coordinates", "utm", "mgrs", "geohash", "plus-code",
    "gcj-02", "bd-09", "traceroute", "geoip", "offline-first", "nmea"
  ],
  "files": [
    "index.html",
    "README.md",
    "LICENSE",
    "app",
    "vendor",
    "server.py",
    "docs",
    "示例数据",
    "说明书.md",
    "启动-Windows.bat",
    "启动-macOS.command",
    "启动-macOS-Linux.sh",
    "启动-Android.sh"
  ]
}
